{
  "$schema": "https://github.com/dyoshikawa/rulesync/releases/latest/download/mcp-schema.json",
  "mcpServers": {
    "codebase-memory": {
      "enabled": true,
      "command": "codebase-memory-mcp",
      "default_tools_approval_mode": "approve",  // codex
    },
    "semble": {
      "enabled": false,
      "command": "uvx",
      "args": ["--from", "semble[mcp]", "semble"],
      "default_tools_approval_mode": "approve",  // codex
    },
  },
}
