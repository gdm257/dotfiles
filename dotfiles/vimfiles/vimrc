" Enable this if backspace key can not be used
" if has("win32") || has("win64")
"   source ./defaults.vim
" endif


" ======== Encoding ========
set fileformat=unix
set fileformats=unix,dos
set termencoding=utf-8
set encoding=utf8
set fileencodings=ucs-bom,utf-8,cp936,gb18030,euc-jp,cp932,sjis,euc-kr
language messages en_US.utf-8


" ======== UI/UX ========
set timeoutlen=400
set jumpoptions=stack
set ignorecase smartcase
set laststatus=2
" set cursorline
highlight CursorLine cterm=NONE ctermbg=17 ctermfg=NONE
if has("win32") || has("win64")
  " 取消光标闪烁（貌似没用）
  set novisualbell
  " Set cursor shape and color
  let &t_SI = "\<Esc>[6 q" " INSERT mode
  let &t_SR = "\<Esc>[6 q" " REPLACE mode
  let &t_EI = "\<Esc>[2 q" " NORMAL mode
  " 1 -> blinking block  闪烁的方块
  " 2 -> solid block  不闪烁的方块
  " 3 -> blinking underscore  闪烁的下划线
  " 4 -> solid underscore  不闪烁的下划线
  " 5 -> blinking vertical bar  闪烁的竖线
  " 6 -> solid vertical bar  不闪烁的竖线
endif


" ======== vim-plug ========
call plug#begin()
Plug 'wakatime/vim-wakatime'
Plug 'itchyny/lightline.vim'
Plug 'tpope/vim-vinegar'
Plug 'tpope/vim-sensible'
Plug 'tpope/vim-surround'
Plug 'tpope/vim-commentary'
Plug 'tpope/vim-repeat'
Plug 'justinmk/vim-sneak'
Plug 'junegunn/fzf', { 'do': { -> fzf#install() } }
Plug 'junegunn/fzf.vim'
Plug 'mg979/vim-visual-multi', {'branch': 'master'}
Plug 'liuchengxu/vim-which-key', { 'on': ['WhichKey', 'WhichKey!'] }
" `:PlugInstall` to install plugins
call plug#end()

let g:sneak#label = 1


" ======== Key bindings ========
let g:mapleader = "\<space>"
inoremap jj <Esc>
inoremap jk <Esc>:w<CR>
nnoremap <silent> <leader> :<c-u>WhichKey '<Space>'<CR>
